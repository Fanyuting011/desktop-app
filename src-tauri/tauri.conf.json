{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutGate",
  "version": "0.1.9",
  "identifier": "com.outgate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OutGate",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NUMzRUJCMkY2OTg1QTYKUldTbWhXa3Z1ejVjT0pNS0s3bW4wUnBzVm00NzlwRlJHRzhKNklBQUZOR3AvY0daZ2xqVjFZakUK",
      "endpoints": [
        "https://github.com/Fanyuting011/desktop-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
